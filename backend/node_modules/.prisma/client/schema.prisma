datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id             String    @id @default(uuid())
  nome           String
  email          String    @unique
  senhaHash      String    @map("senha_hash")
  papel          String    @default("ALUNO") // ALUNO, ADMIN, INSTRUTOR
  telefone       String?
  dataNascimento DateTime? @map("data_nascimento")
  foto           String?
  objetivo       String?
  criadoEm       DateTime  @default(now()) @map("criado_em")

  matriculas    Matricula[]
  agendamentos  Agendamento[]
  fichasAluno   FichaTreino[] @relation("AlunoFichas")
  fichasCriadas FichaTreino[] @relation("InstrutorFichas")
  notificacoes  Notificacao[]

  @@map("usuarios")
}

model Modalidade {
  id        String  @id @default(uuid())
  nome      String
  descricao String?
  imagem    String?
  ativa     Boolean @default(true)

  aulas      Aula[]
  matriculas Matricula[]

  @@map("modalidades")
}

model Matricula {
  id           String    @id @default(uuid())
  usuarioId    String    @map("usuario_id")
  modalidadeId String    @map("modalidade_id")
  status       String    @default("ATIVA") // ATIVA, INADIMPLENTE, CANCELADA, PENDENTE
  dataInicio   DateTime  @default(now()) @map("data_inicio")
  dataFim      DateTime? @map("data_fim")

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  modalidade Modalidade @relation(fields: [modalidadeId], references: [id], onDelete: Cascade)

  @@map("matriculas")
}

model Aula {
  id           String   @id @default(uuid())
  modalidadeId String   @map("modalidade_id")
  tipo         String   @default("AULA") // AULA, AVALIACAO
  instrutor    String
  sala         String   @default("Sala 1")
  dataHora     DateTime @map("data_hora")
  duracaoMin   Int      @default(60) @map("duracao_min")
  capacidade   Int      @default(20)
  status       String   @default("AGENDADA") // AGENDADA, REALIZADA, CANCELADA

  modalidade   Modalidade    @relation(fields: [modalidadeId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@map("aulas")
}

model Agendamento {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  aulaId    String   @map("aula_id")
  status    String   @default("CONFIRMADO") // CONFIRMADO, CANCELADO, FILA_ESPERA
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aula    Aula    @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, aulaId])
  @@map("agendamentos")
}

model FichaTreino {
  id          String    @id @default(uuid())
  alunoId     String    @map("aluno_id")
  criadaPorId String    @map("criada_por")
  objetivo    String?
  validade    DateTime?
  criadaEm    DateTime  @default(now()) @map("criada_em")

  aluno     Usuario     @relation("AlunoFichas", fields: [alunoId], references: [id], onDelete: Cascade)
  instrutor Usuario     @relation("InstrutorFichas", fields: [criadaPorId], references: [id], onDelete: Cascade)
  itens     ItemFicha[]

  @@map("fichas_treino")
}

model ItemFicha {
  id         String  @id @default(uuid())
  fichaId    String  @map("ficha_id")
  exercicio  String
  series     Int
  repeticoes String
  carga      String?
  observacao String?
  ordem      Int     @default(1)

  ficha FichaTreino @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@map("itens_ficha")
}

model Notificacao {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  titulo    String
  mensagem  String
  lida      Boolean  @default(false)
  criadaEm  DateTime @default(now()) @map("criada_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("notificacoes")
}
